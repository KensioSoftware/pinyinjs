{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  // Migrated from Prettier, which oxfmt matches byte for byte across this
  // repo's TypeScript, Markdown, JSON and YAML bar two files, both of which it
  // breaks onto more lines than Prettier did.
  "trailingComma": "all",
  "tabWidth": 2,
  "printWidth": 80,
  "sortPackageJson": false,

  "ignorePatterns": [
    "tmp/",
    ".tmp/",
    // Generated output, committed on purpose. The generators format it as they
    // write it, reading whatever configuration applies where it lands, so what
    // a fixture looks like is decided there rather than by a `pnpm fmt` over
    // this repository.
    "fixtures/",
    "dist/",
    "coverage/",
    "test/.coverage/",
    "node_modules/",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".claude/",
    "CLAUDE.md"
  ]
}
