{
  "name": "@kensio/pinyinjs",
  "version": "1.2.2",
  "description": "Chinese hanzi to pinyin conversion",
  "repository": "https://github.com/KensioSoftware/pinyinjs",
  "homepage": "https://pinyinjs.dev",
  "bugs": "https://github.com/KensioSoftware/pinyinjs/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pinyinjs": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/dictionary/node-source.d.ts",
      "import": "./dist/dictionary/node-source.js"
    },
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "./dist/cli/main.js"
  ],
  "imports": {
    "#test/*": "./test/*"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "cli": "node --import jiti/register src/cli/main.ts",
    "build:check": "tsc -p tsconfig.json --noEmit",
    "fmt": "eslint --fix . && prettier --write .",
    "lint": "eslint . && prettier --check .",
    "fta": "./scripts/sh/fta.sh",
    "pack:check": "./scripts/sh/pack-check.sh",
    "build:data": "node --import jiti/register scripts/build-data/build.ts",
    "fetch:data": "node --import jiti/register scripts/build-data/fetch.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm fmt && pnpm fta && pnpm build && pnpm build:check && pnpm test:coverage",
    "accuracy": "node --import jiti/register scripts/build-data/accuracy.ts",
    "polyphones": "node --import jiti/register scripts/build-data/polyphones.ts",
    "numerals": "node --import jiti/register scripts/build-data/numerals.ts",
    "transcription": "node --import jiti/register scripts/build-data/transcription.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kensio/smartass": "^1.33.0",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.22",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.13",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unicorn": "^71.0.0",
    "fta-cli": "^3.0.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "chinese",
    "pinyin",
    "conversion",
    "hanzi"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Kensio Software",
  "license": "Apache-2.0 AND CC-BY-SA-4.0",
  "type": "module"
}
